<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CON-S03: Only INTERNET permission required -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KnowledgeMapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_ember_logo_main"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_ember_logo_main"
        android:supportsRtl="true"
        android:theme="@style/Theme.KnowledgeMap"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KnowledgeMap">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
